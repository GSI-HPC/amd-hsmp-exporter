[Unit]
Description=Prometheus exporter for AMD EPYC HSMP core telemetry
Documentation=https://github.com/GSI-HPC/amd-hsmp-exporter
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=exec
User=amd-hsmp-exporter
Group=amd-hsmp-exporter
EnvironmentFile=-/etc/sysconfig/amd-hsmp-exporter
ExecStart=/usr/bin/amd-hsmp-exporter $OPTIONS
Restart=on-failure
RestartSec=5

# Hardening. The exporter needs read access to /dev/hsmp (granted to its
# group by the packaged udev rule), /proc/cpuinfo and sysfs — nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/hsmp r

# MSR fallback (opt-in, off by default): reading /dev/cpu/<N>/msr needs
# CAP_SYS_RAWIO, device access and the msr module. Do NOT edit this unit;
# create a drop-in instead:
#
#   # /etc/systemd/system/amd-hsmp-exporter.service.d/msr.conf
#   [Service]
#   CapabilityBoundingSet=CAP_SYS_RAWIO
#   AmbientCapabilities=CAP_SYS_RAWIO
#   DeviceAllow=char-cpu r
#
# then enable the commented msr lines in the packaged udev rule and
# modules-load file, and add --collector.core-energy.msr-fallback to
# OPTIONS in /etc/sysconfig/amd-hsmp-exporter.

[Install]
WantedBy=multi-user.target
